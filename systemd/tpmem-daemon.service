[Unit]
Description=tpmem-daemon — async Claude Code transport router (Telegram + email)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust the path if you cloned the repo somewhere other than ~/tpmem-companion-engine
ExecStart=/usr/bin/python3 %h/tpmem-companion-engine/daemon/main.py
Restart=always
RestartSec=10
# Don't auto-restart in a tight loop if config is broken
StartLimitIntervalSec=300
StartLimitBurst=5

# The Claude Code CLI is typically in ~/.local/bin
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
