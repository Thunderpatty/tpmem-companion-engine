# Copy to ~/.config/tpmem-daemon/secrets.env  —  chmod 600  —  never commit this.
#
# Telegram bot token: create a bot with @BotFather, it gives you the token.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# Email (only needed if email.enabled: true in config.yaml).
# For Gmail, use an App Password, not your account password.
TPMEM_EMAIL_USER=you@example.com
TPMEM_EMAIL_PASSWORD=replace-with-app-password
TPMEM_EMAIL_HOST=imap.gmail.com
TPMEM_EMAIL_PORT=993
