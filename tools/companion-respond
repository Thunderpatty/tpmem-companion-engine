#!/usr/bin/env bash
# companion-respond — companion calls this to send a reply.
#
# Marks the inbox row done AND queues the reply on outbox so the daemon delivers it.
# Companion never touches the transport directly — the daemon does that.
#
# Usage:
#   companion-respond --inbox-id <id> --message "<text>"
#       (replies to the user who sent inbox row <id>, on the same transport)
#
#   companion-respond --transport telegram --reply-to <chat_id> --message "<text>"
#       (unsolicited send — for proactive nudges)
#
#   companion-respond --inbox-id <id> --message-stdin <<'EOF'
#   message body — single-quoted heredoc preserves $, backticks, $(...) verbatim
#   EOF
#       (PREFERRED — argv path is corrupted by caller shell expansion; stdin is opaque)

set -euo pipefail
DB="${TPMEM_DB:-$HOME/.tpmem/kb.db}"

INBOX_ID=""
TRANSPORT=""
REPLY_TO=""
MESSAGE=""
USE_STDIN=0

while [ $# -gt 0 ]; do
  case "$1" in
    --inbox-id)       INBOX_ID="$2"; shift 2 ;;
    --transport)      TRANSPORT="$2"; shift 2 ;;
    --reply-to)       REPLY_TO="$2"; shift 2 ;;
    --message)        MESSAGE="$2"; shift 2 ;;
    --message-stdin)  USE_STDIN=1; shift ;;
    -h|--help)
      grep '^# ' "$0" | head -20
      exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

if [ "$USE_STDIN" -eq 1 ]; then
  if [ -n "$MESSAGE" ]; then
    echo "cannot combine --message and --message-stdin" >&2; exit 2
  fi
  MESSAGE=$(cat)
fi

if [ -z "$MESSAGE" ]; then
  echo "usage: companion-respond --inbox-id <id> --message <text>" >&2
  echo "   or: companion-respond --transport telegram --reply-to <chat_id> --message <text>" >&2
  echo "   or: companion-respond --inbox-id <id> --message-stdin <<'EOF' ... EOF  (preferred)" >&2
  exit 1
fi

esc() { printf '%s' "$1" | sed "s/'/''/g"; }

if [ -n "$INBOX_ID" ]; then
  # Look up transport + reply_to from inbox row
  ROW=$(sqlite3 -separator '|' "$DB" "SELECT transport, reply_to FROM inbox WHERE id=$INBOX_ID;")
  if [ -z "$ROW" ]; then
    echo "no inbox row with id=$INBOX_ID" >&2
    exit 1
  fi
  TRANSPORT="${ROW%|*}"
  REPLY_TO="${ROW#*|}"

  OUT_ID=$(sqlite3 "$DB" "INSERT INTO outbox (transport, reply_to, payload, inbox_id)
    VALUES ('$(esc "$TRANSPORT")', '$(esc "$REPLY_TO")', '$(esc "$MESSAGE")', $INBOX_ID);
    SELECT last_insert_rowid();")
  sqlite3 "$DB" "UPDATE inbox SET status='done', result='companion replied (outbox $OUT_ID)', processed_at=CURRENT_TIMESTAMP WHERE id=$INBOX_ID;"
  echo "queued reply outbox=$OUT_ID for inbox=$INBOX_ID transport=$TRANSPORT"
else
  if [ -z "$TRANSPORT" ] || [ -z "$REPLY_TO" ]; then
    echo "must provide --inbox-id OR (--transport AND --reply-to)" >&2
    exit 1
  fi
  OUT_ID=$(sqlite3 "$DB" "INSERT INTO outbox (transport, reply_to, payload)
    VALUES ('$(esc "$TRANSPORT")', '$(esc "$REPLY_TO")', '$(esc "$MESSAGE")');
    SELECT last_insert_rowid();")
  echo "queued unsolicited outbox=$OUT_ID transport=$TRANSPORT to=$REPLY_TO"
fi
